  <DUT Name="ST_EL1809" Id="{75a73e5d-4ca3-4f42-b76f-6978af3e18bb}">
    <Declaration><![CDATA[TYPE ST_EL1809 :
STRUCT
	//--------------------------------------------------------------------------------------------------------
	sTerminalName                                           :   STRING(200):= 'EL1809 | 16-Channel Digital Input';
    //============================================================================================================================	
	// TERMINAL - EL1809 16-Channel Digital Input Terminal (Term 8)	
	iStartButoon                			AT %I*			: 	BOOL;	// EL1809 channel 1
	iStopButton                   			AT %I*			: 	BOOL;	// EL1809 channel 2
	iUP_OK        							AT %I*	 		: 	BOOL;	// EL1809 channel 3
	iUS_OK		   							AT %I*	 		: 	BOOL;	// EL1809 channel 4
	iProcessCylinderExtended1  				AT %I*	 		: 	BOOL;	// EL1809 channel 5 		     			
	iProcessCylinderRetracted1  			AT %I*			: 	BOOL;	// EL1809 channel 6
	iProcessCylinderExtended2    			AT %I*          :   BOOL;   // EL1809 channel 7 
    iProcessCylinderRetracted2        		AT %I*          :   BOOL;   // EL1809 channel 8
    iVacuumCylinderExtended1           		AT %I*          :   BOOL;   // EL1809 channel 9
	iVacuumCylinderRetracted1             	AT %I*          :   BOOL;   // EL1809 channel 10
	iVacuumCylinderExtended2              	AT %I*          :   BOOL;   // EL1809 channel 11
	iVacuumCylinderRetracted2			    AT %I*          :   BOOL;   // EL1809 channel 12	   
	iRejectSensor         		   			AT %I*	 		: 	BOOL;	// EL1809 channel 13   
	iEL1809_Ch14       						AT %I*	 		: 	BOOL;	// EL1809 channel 14 
	iPuckSensorUp							AT %I*			: 	BOOL;	// EL1809 channel 15  
	iPuckSensorDown							AT %I*	 		: 	BOOL;	// EL1809 channel 16  	
	
	stTerminalInfo											: 	ST_Terminal_Info;

END_STRUCT
END_TYPE
]]></Declaration>
